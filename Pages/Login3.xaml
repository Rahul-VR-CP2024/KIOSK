<Page x:Class="Exchange.Pages.Login3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Exchange.Pages" mc:Ignorable="d" d:DesignHeight="1300" d:DesignWidth="1000" Title="Login2">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <Image Source="/Images/wallstreetwhite.jpeg" Width="300" Height="250"/>
                <TextBlock x:Name="OTPtitle" Text="OTP" FontWeight="Light" FontFamily="helvetica" FontSize="50" Foreground="White" Margin="0,100,0,100" HorizontalAlignment="Center" Height="99" Width="240"/>

            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,50,0,0">
                <!--testimran67895 12345678 -->
                <StackPanel Orientation="Horizontal" Margin="350,50,0,0">
                    <StackPanel Orientation="Horizontal" Width="733">
                        <TextBox x:Name="OTPTextBox" FontFamily="Helvetica"
                                 FontWeight="Light"
                                 Text=""
                                 FontSize="24"
                                 HorizontalAlignment="Center"
                                 Width="230"
                                 Foreground="White"
                                 BorderThickness="0"
                             TextAlignment="Left"
                                 
                                 HorizontalContentAlignment="Center"
                                 Opacity="0.5"
                                 Height="40"
                                 Margin="0,0,0,0"/>
                        <TextBox x:Name="usernameHidden"
         Visibility="Collapsed"/>
                        <TextBox x:Name="passwordHidden"
         Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,150,0,0" HorizontalAlignment="Center">
                    <!--<Button Width="100" Height="40" Content="LOGIN" Margin="0,0,60,0" Click="LoginButton_Clickx"/>-->
                    <Button Content="OK" Width="300" Height="70" BorderThickness="0" Foreground="#10358e" FontSize="30" Click="OK_Click" x:Name="OK">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF " Offset="0"/>
                                <GradientStop Color="#FFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <!--<Button Width="100" Height="40" Content="LOGIN" Margin="0,0,60,0" Click="LoginButton_Clickx"/>-->
                    <!--<Button Width="100" Height="40" Content="LOGIN" Margin="0,0,60,0" Click="LoginButton_Clickx"/>-->
                    <!--<Button Width="100" Height="40" Content="REGISTER" Click="RegisterButton_Clickx"/>-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,50,0,0" HorizontalAlignment="Center">
                    <!--<Button Content="Reset Password" Width="300" Height="70" BorderThickness="0" Margin="0,0,0,0" Foreground="#10358e" FontSize="30" Click="resetpasswordclick" x:Name="resetpasswordbtn"> <Button.Background> <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"> <GradientStop Color="#FFFF " Offset="0"/> <GradientStop Color="#FFFF" Offset="1"/> </LinearGradientBrush> </Button.Background> <Button.Resources> <Style TargetType="Border"> <Setter Property="CornerRadius" Value="10"></Setter> </Style> </Button.Resources> </Button>-->
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Margin="0,0,0,0">
                <Button Content="Back" Width="200" Height="70" BorderThickness="0" Margin="0,50,50,0" Foreground="#10358e" FontSize="30" Click="BackButton_Click" x:Name="backbutton" >
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFF " Offset="0"/>
                            <GradientStop Color="#FFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page> 
